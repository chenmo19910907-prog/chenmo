# Cloudflare Tunnel 配置示例
# 复制到 ~/.cloudflared/config.yml 并按注释修改
#
# 前置步骤（只需做一次）：
#   1. 注册 Cloudflare 并添加你的域名
#   2. cloudflared tunnel login
#   3. cloudflared tunnel create chenmo
#   4. 在 Cloudflare DNS 添加 CNAME：chenmo -> <tunnel-id>.cfargotunnel.com（Proxied）
#   5. 将下方 tunnel / credentials-file / hostname 改成你的实际值

tunnel: <your-tunnel-id>
credentials-file: /Users/<you>/.cloudflared/<your-tunnel-id>.json

ingress:
  - hostname: chenmo.example.com
    service: http://localhost:3456
  - service: http_status:404
