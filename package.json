{
  "name": "chenmo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/export-variants-for-pages.mjs && npm run build",
    "build:gh-pages": "bash scripts/build-github-pages.sh",
    "start": "NODE_ENV=production node server/index.mjs",
    "deploy:aliyun": "bash scripts/deploy-aliyun.sh",
    "sync:vps": "bash scripts/sync-to-vps.sh",
    "sync:momo-work": "node scripts/sync-momo-work-from-kb.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "node-cron": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
